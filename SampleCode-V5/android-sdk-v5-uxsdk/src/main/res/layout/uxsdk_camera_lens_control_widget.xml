<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:parentTag="dji.v5.ux.cameracore.widget.cameracontrols.lenscontrol.LensControlWidget">

    <ImageView
        android:id="@+id/first_len_btn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/uxsdk_drawable_dark_gray_circle_button"
        android:padding="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/uxsdk_ic_camera_lens"
        app:tint="@color/uxsdk_white"
        tools:ignore="ContentDescription"
        tools:tint="@color/uxsdk_white" />
</androidx.constraintlayout.widget.ConstraintLayout>